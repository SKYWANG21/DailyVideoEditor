{
  "name": "daily-video-editor",
  "private": false,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node scripts/bump-version.mjs && vite build --mode lib",
    "build:demo": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:transitions-wasm": "node scripts/build-transitions-wasm.mjs",
    "test": "vitest run",
    "test:browser": "node tests/browser-transitions.mjs"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./transitions/crossfade.wasm": "./dist/algorithm/transitions/crossfade.wasm"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.58.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@webav/av-cliper": "^1.2.8",
    "element-plus": "^2.14.7",
    "pinia": "^2.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-dts": "4.5.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
